# Copy to `.env.docker` (gitignored) and fill in CONVEX_INSTANCE_SECRET.
# `scripts/docker-up.sh` will auto-generate a secret if `.env.docker` is missing.

# --- Port registry (Fitbit = project #7) -------------------------------------
FITBIT_PORT_CONVEX=10710
FITBIT_PORT_SITE_PROXY=10715
FITBIT_PORT_DASHBOARD=10717

# --- Convex backend identity --------------------------------------------------
CONVEX_INSTANCE_NAME=fitbit-clone

# 64-char hex (32 random bytes). Generate with:
#   openssl rand -hex 32
CONVEX_INSTANCE_SECRET=REPLACE_WITH_64_CHAR_HEX

# Origins echoed back to clients. Keep in sync with the ports above.
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:10710
CONVEX_SITE_ORIGIN=http://127.0.0.1:10715

# --- Optional overrides -------------------------------------------------------
# Pin to a specific Convex version instead of :latest for reproducibility.
# CONVEX_BACKEND_IMAGE=ghcr.io/get-convex/convex-backend:2026-04-01
# CONVEX_DASHBOARD_IMAGE=ghcr.io/get-convex/convex-dashboard:2026-04-01

# Rust log level for the backend: trace | debug | info | warn | error
CONVEX_LOG_LEVEL=info
